<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Saved chats stay off the cloud: they can hold letters and labels read
             aloud. A phone-to-phone transfer (below) still carries them. -->
        <exclude domain="file" path="memories/" />
        <!-- Models are downloads (hundreds of MB to 2.6 GB, far over the backup quota) -->
        <exclude domain="file" path="stt/" />
        <exclude domain="external" path="." />
        <!-- The API key is encrypted with a key that never leaves this phone -->
        <exclude domain="sharedpref" path="sight_buddy_api.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Models are downloads (hundreds of MB to 2.6 GB, far over the backup quota) -->
        <exclude domain="file" path="stt/" />
        <exclude domain="external" path="." />
        <!-- The API key is encrypted with a key that never leaves this phone -->
        <exclude domain="sharedpref" path="sight_buddy_api.xml" />
    </device-transfer>
</data-extraction-rules>
